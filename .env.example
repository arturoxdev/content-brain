# ───────────────────────────────────────────────────────────────
# Content Brain — variables de entorno
# Copia este archivo a .env.local y llena los valores.
# ───────────────────────────────────────────────────────────────

# Único usuario de la app
AUTH_USERNAME=
AUTH_PASSWORD=
# Secreto para firmar la cookie de sesión. Genera uno con:  openssl rand -base64 32
AUTH_SECRET=

# Turso (https://turso.tech)
# Ejemplo: libsql://content-brain-tuusuario.aws-us-east-1.turso.io
# Para desarrollo sin Turso puedes usar un archivo local:  file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=
